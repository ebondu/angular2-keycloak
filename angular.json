{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ng-keycloak": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "keycloak",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/ng-keycloak"
            },
            "index": false,
            "tsConfig": "src/tsconfig.json",
            "scripts": [],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": ""
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "ng-keycloak:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "ng-keycloak:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "ng-keycloak:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "src/tsconfig.spec.json",
            "karmaConfig": "src/karma.conf.js",
            "styles": [
              "src/styles.css"
            ],
            "scripts": [],
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ]
          }
        }
      }
    },
    "@ebondu/angular-keycloak": {
      "root": "projects/ebondu/angular-keycloak",
      "sourceRoot": "projects/ebondu/angular-keycloak/src",
      "projectType": "library",
      "prefix": "keycloak",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ebondu/angular-keycloak/tsconfig.lib.json",
            "project": "projects/ebondu/angular-keycloak/ng-package.json"
          },
          "configurations": {
            "production": {
              "project": "projects/ebondu/angular-keycloak/ng-package.prod.json",
              "tsConfig": "projects/ebondu/angular-keycloak/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/ebondu/angular-keycloak/src/test.ts",
            "tsConfig": "projects/ebondu/angular-keycloak/tsconfig.spec.json",
            "karmaConfig": "projects/ebondu/angular-keycloak/karma.conf.js"
          }
        }
      }
    },
    "angular6-example-app": {
      "root": "projects/angular6-example-app/",
      "sourceRoot": "projects/angular6-example-app/src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/angular6-example-app"
            },
            "index": "projects/angular6-example-app/src/index.html",
            "polyfills": [
              "projects/angular6-example-app/src/polyfills.ts"
            ],
            "tsConfig": "projects/angular6-example-app/tsconfig.app.json",
            "assets": [
              "projects/angular6-example-app/src/favicon.ico",
              "projects/angular6-example-app/src/assets"
            ],
            "styles": [
              "projects/angular6-example-app/src/styles.css"
            ],
            "scripts": [],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "projects/angular6-example-app/src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/angular6-example-app/src/environments/environment.ts",
                  "with": "projects/angular6-example-app/src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "angular6-example-app:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "angular6-example-app:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "angular6-example-app:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/angular6-example-app/src/test.ts",
            "polyfills": "projects/angular6-example-app/src/polyfills.ts",
            "tsConfig": "projects/angular6-example-app/tsconfig.spec.json",
            "karmaConfig": "projects/angular6-example-app/karma.conf.js",
            "styles": [
              "projects/angular6-example-app/src/styles.css"
            ],
            "scripts": [],
            "assets": [
              "projects/angular6-example-app/src/favicon.ico",
              "projects/angular6-example-app/src/assets"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
